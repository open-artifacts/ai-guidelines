# Copie para .env e ajuste. O .env nao vai para o Git.

# Site autorizado a chamar a API (origem, sem barra final e sem caminho).
ALLOWED_ORIGIN=https://open-artifacts.github.io

# Apenas com `--profile https`: dominio cujo DNS (registro A) aponta para esta VPS.
API_DOMAIN=api.exemplo.org

# Opcionais
# API_PORT=3000
# MAX_RATING_ID=17
